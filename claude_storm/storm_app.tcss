#header-bar {
    dock: top;
    height: 2;
    padding: 0 1;
    background: $surface;
    color: $text;
}

#output-log {
    height: 1fr;
}

#hints-bar {
    height: 1;
    color: $text-muted;
    padding: 0 1;
}

ThinkingBar {
    height: 1;
    color: $text;
}

#scroll-indicator {
    display: none;
    height: 1;
    color: $warning;
    text-align: center;
}
